{
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/controllers/([a-z_]+)\\.php$", "dest": "/api/index.php" },
    { "src": "/$", "dest": "/index.html" },
    { "src": "/((?:index|admission|application_form|register)\\.html|(?:assets|form|student)/[A-Za-z0-9_-]+\\.(?:html|css|js|png|jpg))$", "dest": "/$1" },
    { "src": "/.*", "status": 404 }
  ]
}
